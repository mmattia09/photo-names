{
  "manifest_version": 3,
  "name": "Photo Names",
  "version": "1.3.1",
  "description": "Fill an Immich photo description with the names of the people recognised in it.",
  "homepage_url": "https://github.com/mmattia09/photo-names",
  "browser_specific_settings": {
    "gecko": {
      "id": "photo-names@mmattia09.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["src/background.js"]
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Photo Names settings",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  }
}
